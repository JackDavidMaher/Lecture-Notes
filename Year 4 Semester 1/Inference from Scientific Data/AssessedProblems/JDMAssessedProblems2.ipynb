    "import seaborn as sns\n",
    "def make_data():\n",
    "penguins = sns.load_dataset(\"penguins\")\n",
    "penguins = penguins.sample(frac=1)\n",
    "penguins.dropna(inplace=True)\n",
    "return penguins[['flipper_length_mm', 'body_mass_g']]\n",
    "data = make_data()\n",
    "data.head()"
